{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mylasertools": {
      "type": "streamable-http",
      "url": "https://www.mylasertools.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["offline_access", "art:read", "art:download", "design:handoff", "tools:use"],
            "defaultScopes": []
          }
        }
      }
    }
  }
}
